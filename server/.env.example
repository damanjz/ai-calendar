# Server
# API_PORT takes precedence over PORT (some hosts inject PORT for the app being
# launched, which would make the API bind the UI's port).
API_PORT=3000

# Interface to bind. Defaults to loopback: this is a single-user self-hosted
# tool. Only change this if you also set API_KEY.
# HOST=127.0.0.1

# Optional: require an API key on every /api request (sent as x-api-key or Bearer).
# Strongly recommended if you change HOST away from 127.0.0.1.
# API_KEY=

# Allowed browser origin for CORS. Defaults to the Vite dev origin.
# Use "*" only if you understand that any site may then call this API.
# CORS_ORIGIN=http://localhost:5173

# Which providers the server should list as active (comma-separated)
# local is always available and needs no credentials
PROVIDERS=local,google,outlook,caldav

# --- Google Calendar -------------------------------------------------------
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Microsoft 365 / Outlook (Graph API) ------------------------------------
OUTLOOK_ENABLED=false
# Use a tenant id, "common", "organizations", or "consumers"
OUTLOOK_TENANT=common
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback

# --- CalDAV (Apple, Nextcloud, Baikal, ...) ---------------------------------
# Comma-separated list of calendar collection URLs.
# Example: https://nextcloud.example.com/remote.php/dav/calendars/me/personal/
CALDAV_ENABLED=false
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
