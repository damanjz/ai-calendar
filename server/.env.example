# Server
PORT=3000
# Optional: require an API key on every /api request (sent as x-api-key or Bearer)
# API_KEY=

# Allowed browser origin for CORS (default: * for development)
# CORS_ORIGIN=http://localhost:5173

# Which providers the server should list as active (comma-separated)
# local is always available and needs no credentials
PROVIDERS=local,google,outlook,caldav

# --- Google Calendar -------------------------------------------------------
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Microsoft 365 / Outlook (Graph API) ------------------------------------
OUTLOOK_ENABLED=false
# Use a tenant id, "common", "organizations", or "consumers"
OUTLOOK_TENANT=common
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback

# --- CalDAV (Apple, Nextcloud, Baikal, ...) ---------------------------------
# Comma-separated list of calendar collection URLs.
# Example: https://nextcloud.example.com/remote.php/dav/calendars/me/personal/
CALDAV_ENABLED=false
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
